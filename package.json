{
  "name": "vitrineadt-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "build:demo": "node scripts/build-site.mjs --data tests/fixtures/apps --output .preview",
    "check": "node --check scripts/*.mjs && node --check site/*.js",
    "dev": "node scripts/serve.mjs dist",
    "labels:setup": "node scripts/setup-labels.mjs",
    "seed:issues": "node scripts/seed-existing-issues.mjs",
    "likes:changed": "node scripts/likes-changed.mjs --old dist/data/apps.json",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  }
}
